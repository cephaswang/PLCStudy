(* ============================================================
   程式名稱：Analog_Input_Scaling（結構化文字 ST 版）
   對應來源：MAIN Program（梯形圖版，RCPU R16EN / 搭配 Q64AD 類比輸入模組）
   功能說明：
     讀取 Q64AD 類比輸入模組經 Auto_Refresh 寫入的數位輸出值(D0)，
     先轉為浮點數，再依「滿量程 ÷ 最大數位值」計算出換算係數，
     最後將原始浮點值乘上換算係數，得到對應的實際工程量測值
     （例如壓力、液位等實際物理量），供後續控制或監看使用。
   ============================================================ *)

VAR
    D0    : INT;             (* Q64AD CH1 數位輸出值，由 Auto_Refresh 自動由緩衝區寫入 *)
    D20   : REAL;            (* D0 轉換後的浮點數，代表類比輸入的原始數值 *)
    D22   : REAL;            (* 換算係數 factor = 滿量程 ÷ 最大數位值 *)
    D24   : REAL;            (* 實際量測值 Actual load value（工程單位） *)
    E100  : REAL := 100.0;   (* 感測器滿量程常數，例如 0~100 kPa／0~100%，依實際規格調整 *)
    E4000 : REAL := 4000.0;  (* 一般解析度模式下，4-20mA 輸入對應的最大數位值 (0~4000) *)
END_VAR

(* ------------------------------------------------------------
   Step 1：整數轉浮點數（對應原梯形圖 INT2FLT / FLT 指令）
   將類比模組讀回的原始整數 D0 轉換成浮點數 D20，
   以便後續進行浮點四則運算。
------------------------------------------------------------ *)
D20 := INT_TO_REAL(D0);

(* ------------------------------------------------------------
   Step 2：計算換算係數（對應原梯形圖 E/ 除法指令）
   factor = 滿量程(E100) ÷ 最大數位值(E4000)
   範例：滿量程 0~100，數位值 0~4000 → factor = 100/4000 = 0.025
   此係數僅與硬體規格有關，程式執行期間為固定值。
------------------------------------------------------------ *)
D22 := E100 / E4000;

(* ------------------------------------------------------------
   Step 3：計算實際量測值（對應原梯形圖 E* 乘法指令）
   Actual = 原始浮點值(D20) × 換算係數(D22)
   即將 0~4000 的數位值線性轉換為 0~100（或其他設定的滿量程）
   的實際工程單位數值。
------------------------------------------------------------ *)
D24 := D20 * D22;

(* 程式結束，功能等同原梯形圖之 END 指令（ST 語言不需額外撰寫） *)
