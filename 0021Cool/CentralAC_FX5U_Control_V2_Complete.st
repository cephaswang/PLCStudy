(* =====================================================================
   中央空調系統 電控程式 - 完整版
   PLC型號：三菱 iQ-F FX5U-64MR/ES ＋ FX5-4AD
   語言　　：ST (Structured Text)
   版本　　：V2.0（完整版，含RS-485 Modbus RTU通訊、PID運算、
             警報紀錄、HMI資料整理；V1.0核心連鎖邏輯全部保留）
   -----------------------------------------------------------------
   ＊本版與V1.0的差異：
     1. 修正RS-485站號：Modbus位址0為廣播位址，不可指派給任何從站，
        V1.0文件中「站0＝冰水主機」為誤植，本版更正為站1~站7
        （原《配線標籤文字列表》《VFD參數設定表》之站號請同步更正）
     2. 新增RS-485 Modbus RTU通訊輪詢程式(使用ADPRW指令)
     3. 新增冰水泵浦/冷卻水泵浦/冷卻水塔風扇之PID頻率運算(使用PID指令)
     4. 新增類比訊號工程單位換算
     5. 新增警報代碼表與HMI資料整理區
   ===================================================================== *)


(* =====================================================================
   一、I/O 點位分配表（與V1.0相同，未變更）
   ===================================================================== *)
(*
  ---------- 數位輸入 DI ----------
  X0   冰水主機故障警報(綜合)          X1   冰水主機機側/遠端模式回授
  X2   CT1手動/自動選擇(自動=1)        X3   CT1運轉/故障回授
  X4   CT2手動/自動選擇(自動=1)        X5   CT2運轉/故障回授
  X6   CHWP1手動/自動選擇(自動=1)      X7   CHWP1運轉/故障回授
  X10  CHWP2手動/自動選擇(自動=1)      X11  CHWP2運轉/故障回授
  X12  CWP1手動/自動選擇(自動=1)       X13  CWP1運轉/故障回授
  X14  CWP2手動/自動選擇(自動=1)       X15  CWP2運轉/故障回授
  X16  冰水流量開關                    X17  冷卻水流量開關
  X20  水塔水盤液位開關(正常=1)        X21  冰水主機運轉狀態回授
  X22  緊急停止按鈕(常閉)              X23  系統啟動按鈕
  X24  系統停止按鈕                    X25  總電源/相序監視(正常=1)

  ---------- 數位輸出 DO ----------
  Y0   冰水主機遠端啟動/停止指令       Y1~Y2  CT1/CT2啟停指令
  Y3~Y4  CHWP1/CHWP2啟停指令          Y5~Y6  CWP1/CWP2啟停指令
  Y7   警報燈輸出                      Y10  蜂鳴器輸出

  ---------- 類比輸入(FX5-4AD，經模組緩衝記憶體自動更新) ----------
  D1000~D1003  CHWP1/CHWP2/CWP1/CWP2 出口壓力 原始值(0~4000對應4-20mA)
  D1010~D1013  上列訊號換算後壓力值，單位0.01MPa

  ---------- RS-485 Modbus RTU 通訊站號(本版更正) ----------
  站1：冰水主機CH1　　站2：CT1　　站3：CT2
  站4：CHWP1　　　　　站5：CHWP2　站6：CWP1　　站7：CWP2
*)


(* =====================================================================
   二、內部暫存器規劃
   ===================================================================== *)
(*
  ---- 通訊讀取資料區 (由站1~站7讀回，D2000起) ----
  D2000  站1 冰水出水溫度(0.1℃)        D2001  站1 冰水入水溫度(0.1℃)
  D2002  站1 冷凝器出水溫度(0.1℃)      D2003  站1 冷凝器入水溫度(0.1℃)
  D2004  站1 冷媒高壓(0.01MPa)          D2005  站1 冷媒低壓(0.01MPa)
  D2006  站1 故障碼(原廠定義)
  D2010  站2(CT1) 輸出頻率(0.01Hz)      D2011  站2(CT1) 輸出電流(0.01A)
  D2012  站3(CT2) 輸出頻率              D2013  站3(CT2) 輸出電流
  D2014  站4(CHWP1) 輸出頻率            D2015  站4(CHWP1) 輸出電流
  D2016  站5(CHWP2) 輸出頻率            D2017  站5(CHWP2) 輸出電流
  D2018  站6(CWP1) 輸出頻率             D2019  站6(CWP1) 輸出電流
  D2020  站7(CWP2) 輸出頻率             D2021  站7(CWP2) 輸出電流

  ---- 通訊寫入資料區 (頻率命令，PID運算後寫入站2~站7) ----
  D2110  CT1頻率命令(0.01Hz)    D2111  CT2頻率命令
  D2112  CHWP1頻率命令          D2113  CHWP2頻率命令
  D2114  CWP1頻率命令           D2115  CWP2頻率命令

  ---- 通訊輪詢控制 ----
  D0     目前輪詢站號(1~7循環)
  M50    通訊觸發脈波(每輪詢週期ON一次)
  M51    ADPRW完成旗標           M52    ADPRW錯誤旗標
  D2900  ADPRW錯誤代碼           T50    輪詢週期計時器(每站間隔200ms)

  ---- PID運算相關 ----
  D3000~D3024   冰水泵浦壓差PID參數表(25字，依PID指令規格)
  D3030~D3054   冷卻水泵浦壓差PID參數表
  D3060~D3084   冷卻水塔風扇溫度PID參數表
  D3100  冰水側壓差設定值(SV)     D3101  冰水側壓差回授值(PV，取CHWP運轉中泵浦壓力)
  D3102  冷卻水側壓差設定值(SV)   D3103  冷卻水側壓差回授值(PV)
  D3104  冷卻水回水溫度設定值(SV) D3105  冷卻水回水溫度回授值(PV，取自站1冷凝器出水溫度)

  ---- 警報代碼與HMI資料整理 ----
  D3200  目前警報代碼(0=無警報)   D3201~D3210  警報歷程緩衝區(最近10筆代碼)
  M200~M220  各類警報個別旗標(供HMI逐項顯示)
*)


(* =====================================================================
   三、保護連鎖判斷（與V1.0相同）
   ===================================================================== *)
IF (X22 = 0)
   OR (X0  = 1)
   OR (X25 = 0)
   OR (X20 = 0)
   OR ((M10 = TRUE) AND (X17 = 0))
   OR ((M11 = TRUE) AND (X16 = 0))
THEN
    M20 := TRUE;
ELSE
    M20 := FALSE;
END_IF;

IF X22 = 0 THEN
    M21 := TRUE;
END_IF;

IF M20 = TRUE THEN
    Y0  := FALSE;  Y1 := FALSE;  Y2 := FALSE;
    Y3  := FALSE;  Y4 := FALSE;  Y5 := FALSE;  Y6 := FALSE;
    Y7  := TRUE;   Y10 := TRUE;
    M0  := FALSE;  M2 := FALSE;  M3 := FALSE;
    M10 := FALSE;  M11 := FALSE; M12 := FALSE;
    D2110 := 0; D2111 := 0; D2112 := 0; D2113 := 0; D2114 := 0; D2115 := 0;
    RETURN;
END_IF;


(* =====================================================================
   四、啟停要求擷取（與V1.0相同）
   ===================================================================== *)
IF (X23 = 1) AND (M2 = FALSE) THEN
    M0 := TRUE;  M1 := FALSE;
END_IF;
IF X24 = 1 THEN
    M1 := TRUE;  M0 := FALSE;
END_IF;


(* =====================================================================
   五、開機程序（與V1.0相同）
   ===================================================================== *)
IF (M0 = TRUE) AND (M10 = FALSE) AND (M1 = FALSE) THEN
    Y1 := TRUE;  Y2 := TRUE;  Y5 := TRUE;  Y6 := TRUE;
    M10 := TRUE;
END_IF;

T0(IN := (M10 = TRUE) AND (X17 = 1), PT := T#20S);

IF (T0.Q = TRUE) AND (M11 = FALSE) AND (M1 = FALSE) THEN
    Y3 := TRUE;  Y4 := TRUE;
    M11 := TRUE;
END_IF;

T1(IN := (M11 = TRUE) AND (X16 = 1), PT := T#15S);

IF (T1.Q = TRUE) AND (M12 = FALSE) AND (M1 = FALSE) THEN
    Y0  := TRUE;
    M12 := TRUE;
    M2  := TRUE;
END_IF;


(* =====================================================================
   六、停機程序（與V1.0相同）
   ===================================================================== *)
IF (M1 = TRUE) AND (M2 = TRUE) AND (M3 = FALSE) THEN
    Y0 := FALSE;
    M3 := TRUE;
END_IF;

T2(IN := (M3 = TRUE), PT := T#180S);

IF T2.Q = TRUE THEN
    Y3 := FALSE; Y4 := FALSE; Y5 := FALSE; Y6 := FALSE;
    Y1 := FALSE; Y2 := FALSE;
    D2110 := 0; D2111 := 0; D2112 := 0; D2113 := 0; D2114 := 0; D2115 := 0;
    M0 := FALSE; M1 := FALSE; M2 := FALSE; M3 := FALSE;
    M10 := FALSE; M11 := FALSE; M12 := FALSE;
END_IF;


(* =====================================================================
   七、類比輸入訊號工程單位換算
   -----------------------------------------------------------------
   FX5-4AD原始值0~4000對應4-20mA，此處假設壓力傳訊器量測範圍0~1.00MPa
   換算公式：壓力(0.01MPa) = 原始值 × 100 / 4000
   ===================================================================== *)
D1010 := D1000 * 100 / 4000;   (* CHWP1出口壓力 *)
D1011 := D1001 * 100 / 4000;   (* CHWP2出口壓力 *)
D1012 := D1002 * 100 / 4000;   (* CWP1出口壓力 *)
D1013 := D1003 * 100 / 4000;   (* CWP2出口壓力 *)


(* =====================================================================
   八、RS-485 Modbus RTU 通訊輪詢程式
   -----------------------------------------------------------------
   ＊使用ADPRW指令(FX5U/FX3U系列Modbus RTU通訊專用指令)，
     實際參數格式(觸發元件/來源暫存器/站號/功能碼/資料筆數/目的暫存器)
     請務必以GX Works3線上說明或FX5U程式設計手冊(通訊篇)之ADPRW指令頁
     核對後調整，本處語法為概念示意，尚未包含每一暫存器位址的完整
     Modbus映射表(需依冰水主機原廠通訊手冊、FR-F840通訊手冊個別確認)。
   ＊RS-485埠須先於GX Works3「模組參數」設定為Modbus RTU主站模式，
     波特率/資料格式需與6台VFD、冰水主機一致(參見《VFD參數設定表》)。
   ===================================================================== *)

(* 輪詢站號循環：1→2→3→4→5→6→7→1... 每站間隔以T50計時 *)
T50(IN := NOT(M51 OR M52), PT := T#200MS);

IF T50.Q = TRUE THEN
    M50 := TRUE;   (* 觸發下一次通訊 *)
ELSE
    M50 := FALSE;
END_IF;

IF M50 = TRUE THEN
    CASE D0 OF
        1: (* 站1：冰水主機 - 讀取溫度/壓力/故障碼(功能碼03，讀取7個保持暫存器) *)
           ADPRW(M50, K1, H03, K0, K7, D2000);
        2: (* 站2：CT1 - 讀取輸出頻率/電流 *)
           ADPRW(M50, K2, H03, K0, K2, D2010);
        3: (* 站3：CT2 *)
           ADPRW(M50, K3, H03, K0, K2, D2012);
        4: (* 站4：CHWP1 *)
           ADPRW(M50, K4, H03, K0, K2, D2014);
        5: (* 站5：CHWP2 *)
           ADPRW(M50, K5, H03, K0, K2, D2016);
        6: (* 站6：CWP1 *)
           ADPRW(M50, K6, H03, K0, K2, D2018);
        7: (* 站7：CWP2 *)
           ADPRW(M50, K7, H03, K0, K2, D2020);
    END_CASE;

    (* 通訊完成或錯誤後，切換至下一站；D2900記錄最近一次錯誤代碼供除錯 *)
    IF (M51 = TRUE) OR (M52 = TRUE) THEN
        IF M52 = TRUE THEN
            D2900 := D2900;  (* 實際錯誤代碼由ADPRW執行結果暫存器提供，依手冊定義擷取 *)
        END_IF;
        D0 := D0 + 1;
        IF D0 > 7 THEN
            D0 := 1;
        END_IF;
        M51 := FALSE;
        M52 := FALSE;
    END_IF;
END_IF;

(* 頻率命令寫入(功能碼06，寫單一暫存器)，僅於對應設備運轉且自動模式時送出 *)
IF (M10 = TRUE) AND (X2 = 1) THEN   (* CT1自動且冷卻側已啟動 *)
    ADPRW(M50, K2, H06, K1, K1, D2110);
END_IF;
IF (M10 = TRUE) AND (X4 = 1) THEN   (* CT2 *)
    ADPRW(M50, K3, H06, K1, K1, D2111);
END_IF;
IF (M11 = TRUE) AND (X6 = 1) THEN   (* CHWP1 *)
    ADPRW(M50, K4, H06, K1, K1, D2112);
END_IF;
IF (M11 = TRUE) AND (X10 = 1) THEN  (* CHWP2 *)
    ADPRW(M50, K5, H06, K1, K1, D2113);
END_IF;
IF (M10 = TRUE) AND (X12 = 1) THEN  (* CWP1 *)
    ADPRW(M50, K6, H06, K1, K1, D2114);
END_IF;
IF (M10 = TRUE) AND (X14 = 1) THEN  (* CWP2 *)
    ADPRW(M50, K7, H06, K1, K1, D2115);
END_IF;

(*
  上列寫入邏輯為概念示意：實務上6台VFD＋1台輪詢讀取共7個通訊請求無法在
  同一個200ms週期內全部送出，需與讀取輪詢共用同一組觸發/完成旗標並排入
  同一輪詢序列(建議擴充D0輪詢範圍為1~13，分別對應7筆讀取+6筆寫入)，
  正式實作時請重新設計完整的輪詢佇列(Polling Queue)，避免通訊衝突。
*)


(* =====================================================================
   九、PID 頻率運算
   -----------------------------------------------------------------
   ＊使用FX系列標準PID指令：PID(SV, PV, S1, D)
     SV=目標值暫存器　PV=回授值暫存器　S1=參數表起始位址(25字)　D=輸出值暫存器
   ＊參數表(取樣時間、比例頻寬、積分時間、微分時間等)需於S1起始位址
     事先寫入，各項定義請依FX5U程式設計手冊(應用篇)PID指令說明設定，
     本處僅示範呼叫方式與訊號來源，實際整定值(P/I/D)需現場試機調整。
   ===================================================================== *)

(* 9.1 冰水泵浦定壓差控制：以運轉中泵浦出口壓力為回授值 *)
IF X6 = 1 THEN
    D3101 := D1010;   (* CHWP1運轉中，取其出口壓力為回授值 *)
ELSIF X10 = 1 THEN
    D3101 := D1011;   (* CHWP2運轉中 *)
END_IF;
(* D3100冰水側壓差設定值由HMI/SCADA設定頁寫入，預設值於初始化程式設定 *)
IF M11 = TRUE THEN
    PID(D3100, D3101, D3000, D2112);
    (* 運算結果先固定寫入CHWP1頻率命令位址，再依實際運轉台複製給對應暫存器 *)
    IF X6 = 1 THEN
        D2112 := D2112;
    ELSIF X10 = 1 THEN
        D2113 := D2112;
        D2112 := 0;
    END_IF;
END_IF;

(* 9.2 冷卻水泵浦定壓差控制 *)
IF X12 = 1 THEN
    D3103 := D1012;
ELSIF X14 = 1 THEN
    D3103 := D1013;
END_IF;
IF M10 = TRUE THEN
    PID(D3102, D3103, D3030, D2114);
    IF X12 = 1 THEN
        D2114 := D2114;
    ELSIF X14 = 1 THEN
        D2115 := D2114;
        D2114 := 0;
    END_IF;
END_IF;

(* 9.3 冷卻水塔風扇控制：以冷凝器出水溫度(冷卻水回水溫度)為回授值 *)
D3105 := D2003;   (* 取自站1(冰水主機)冷凝器出水溫度 *)
IF M10 = TRUE THEN
    PID(D3104, D3105, D3060, D2110);
    IF X2 = 1 THEN
        D2110 := D2110;
    ELSIF X4 = 1 THEN
        D2111 := D2110;
        D2110 := 0;
    END_IF;
END_IF;


(* =====================================================================
   十、警報代碼表與HMI資料整理
   ===================================================================== *)
IF X0 = 1 THEN
    D3200 := 101;  M200 := TRUE;    (* 101=冰水主機故障 *)
ELSIF X3 = 0 AND M10 = TRUE THEN
    D3200 := 201;  M201 := TRUE;    (* 201=CT1運轉異常 *)
ELSIF X5 = 0 AND M10 = TRUE THEN
    D3200 := 202;  M202 := TRUE;    (* 202=CT2運轉異常 *)
ELSIF X7 = 0 AND M11 = TRUE THEN
    D3200 := 301;  M203 := TRUE;    (* 301=CHWP1運轉異常 *)
ELSIF X11 = 0 AND M11 = TRUE THEN
    D3200 := 302;  M204 := TRUE;    (* 302=CHWP2運轉異常 *)
ELSIF X13 = 0 AND M10 = TRUE THEN
    D3200 := 401;  M205 := TRUE;    (* 401=CWP1運轉異常 *)
ELSIF X15 = 0 AND M10 = TRUE THEN
    D3200 := 402;  M206 := TRUE;    (* 402=CWP2運轉異常 *)
ELSIF X16 = 0 AND M11 = TRUE THEN
    D3200 := 501;  M207 := TRUE;    (* 501=冰水流量異常 *)
ELSIF X17 = 0 AND M10 = TRUE THEN
    D3200 := 502;  M208 := TRUE;    (* 502=冷卻水流量異常 *)
ELSIF X20 = 0 THEN
    D3200 := 503;  M209 := TRUE;    (* 503=水塔液位異常 *)
ELSIF X22 = 0 THEN
    D3200 := 001;  M210 := TRUE;    (* 001=緊急停止動作 *)
ELSE
    D3200 := 0;
END_IF;

(* 警報歷程移位緩衝：新警報代碼發生時(D3200由0變為非0)推入歷程區 *)
IF (D3200 <> 0) AND (D3201 <> D3200) THEN
    D3210 := D3209;  D3209 := D3208;  D3208 := D3207;  D3207 := D3206;
    D3206 := D3205;  D3205 := D3204;  D3204 := D3203;  D3203 := D3202;
    D3202 := D3201;  D3201 := D3200;
END_IF;

(*
  HMI/SCADA讀取建議：
  - 系統狀態：M2(運轉中)、M20(保護連鎖)、M0/M1(啟停要求)
  - 溫度/壓力：D2000~D2006(冰水主機)、D1010~D1013(泵浦出口壓力，0.01MPa)
  - 變頻器頻率/電流：D2010~D2021
  - 警報：D3200(目前代碼)、D3201~D3210(歷程)、M200~M210(個別旗標，供燈號對應)
*)

(* ===================== 程式結束 ===================== *)
