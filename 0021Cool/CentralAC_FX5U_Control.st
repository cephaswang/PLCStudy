(* =====================================================================
   中央空調系統 電控程式
   PLC型號：三菱 iQ-F FX5U-64MR/ES
   語言　　：ST (Structured Text)
   內容　　：I/O點位分配、開機/停機連鎖邏輯、保護連鎖
   版本　　：V1.0（範例程式，正式上線前需依實際盤面配線、
             設備廠商規格、SCADA介接需求覆核修改）
   ===================================================================== *)

(* =====================================================================
   一、I/O 點位分配表
   -----------------------------------------------------------------
   ※ 以下裝置編號請於 GX Works3「標籤設定」中建立對應標籤，
     或直接於ST程式中使用下列裝置編號(X/Y/M/T/D)。
   ===================================================================== *)

(* ---------- 數位輸入 DI (X0~X37，占用22點，實配32點內) ---------- *)
(*
  X0   冰水主機 故障警報接點(綜合)              CH1-DI-02
  X1   冰水主機 機側/遠端控制模式回授(遠端=1)     CH1-DI-03
  X2   冷卻水塔風扇#1 手動/自動選擇(自動=1)       CT1-DI-01
  X3   冷卻水塔風扇#1 運轉/故障回授               CT1-DI-02
  X4   冷卻水塔風扇#2 手動/自動選擇(自動=1)       CT2-DI-01
  X5   冷卻水塔風扇#2 運轉/故障回授               CT2-DI-02
  X6   冰水泵浦#1 手動/自動選擇(自動=1)           CHWP1-DI-01
  X7   冰水泵浦#1 運轉/故障回授                   CHWP1-DI-02
  X10  冰水泵浦#2 手動/自動選擇(自動=1)           CHWP2-DI-01
  X11  冰水泵浦#2 運轉/故障回授                   CHWP2-DI-02
  X12  冷卻水泵浦#1 手動/自動選擇(自動=1)         CWP1-DI-01
  X13  冷卻水泵浦#1 運轉/故障回授                 CWP1-DI-02
  X14  冷卻水泵浦#2 手動/自動選擇(自動=1)         CWP2-DI-01
  X15  冷卻水泵浦#2 運轉/故障回授                 CWP2-DI-02
  X16  冰水流量開關(ON=正常有流量)                CHWP-DI-91
  X17  冷卻水流量開關(ON=正常有流量)              CWP-DI-91
  X20  冷卻水塔水盤液位開關(正常=1)               CT-DI-91
  X21  冰水主機 運轉狀態回授                      CH1-DI-01
  X22  緊急停止按鈕(常閉接點，動作時=0)           MCC-DI-01
  X23  系統啟動按鈕                               MCC-DI-03
  X24  系統停止按鈕                               MCC-DI-03
  X25  系統總電源/相序監視(正常=1)                MCC-DI-02
  X26~X37  備用(未來CH2或AHU/FCU擴充)
*)

(* ---------- 數位輸出 DO (Y0~Y37，占用9點，實配32點內) ---------- *)
(*
  Y0   冰水主機 遠端啟動/停止指令                 CH1-DO-01
  Y1   冷卻水塔風扇#1 啟動/停止指令               CT1-DO-01
  Y2   冷卻水塔風扇#2 啟動/停止指令               CT2-DO-01
  Y3   冰水泵浦#1 啟動/停止指令                   CHWP1-DO-01
  Y4   冰水泵浦#2 啟動/停止指令                   CHWP2-DO-01
  Y5   冷卻水泵浦#1 啟動/停止指令                 CWP1-DO-01
  Y6   冷卻水泵浦#2 啟動/停止指令                 CWP2-DO-01
  Y7   警報燈輸出                                 MCC-DO-01
  Y10  蜂鳴器輸出                                 MCC-DO-02
  Y11~Y37  備用
*)

(* ---------- 類比輸入 (經FX5-4AD模組，自動更新至下列暫存器) ---------- *)
(*
  D1000  冰水泵浦#1 出口壓力                      CHWP1-AI-02
  D1001  冰水泵浦#2 出口壓力                      CHWP2-AI-02
  D1002  冷卻水泵浦#1 出口壓力                    CWP1-AI-02
  D1003  冷卻水泵浦#2 出口壓力                    CWP2-AI-02
  ※ 本程式僅監視讀取，未納入自動控制迴路，供SCADA顯示與趨勢記錄用
*)

(* ---------- RS-485 Modbus RTU 通訊資料(讀取，經通訊FB更新) ---------- *)
(*
  站0：冰水主機PLC/HMI(溫度、壓力、故障碼)         CH1-COM-01
  站1：冷卻水塔風扇#1 VFD(頻率/電流回授)
  站2：冷卻水塔風扇#2 VFD
  站3：冰水泵浦#1 VFD
  站4：冰水泵浦#2 VFD
  站5：冷卻水泵浦#1 VFD
  站6：冷卻水泵浦#2 VFD
  ※ 各站資料實際暫存器位址、VFD頻率指令下達方式，
    需依FX5U內建RS-485「預先定義通訊協定/Modbus主站」功能設定，
    並依三菱變頻器(FR-F840)Modbus暫存器手冊配置，本程式以
    子程式 R_ModbusComm 作為預留介面，實作時另行補上通訊FB。
*)

(* ---------- 內部輔助繼電器 M ---------- *)
(*
  M0   系統啟動要求
  M1   系統停止要求
  M2   系統運轉中
  M3   停機程序執行中
  M10  Step1完成旗標(冷卻側已啟動)
  M11  Step2完成旗標(冰水側已啟動)
  M12  Step3完成旗標(冰水主機已下達啟動指令)
  M20  保護連鎖動作旗標
  M21  緊急停止動作旗標
*)

(* ---------- 計時器 T ---------- *)
(*
  T0   冷卻水流量確認後，啟動冰水泵浦前延時 (20秒)
  T1   冰水流量確認後，冰水主機啟動前延時 (15秒)
  T2   冰水主機停止後，餘熱排除延時 (180秒)
*)


(* =====================================================================
   二、主程式邏輯
   ===================================================================== *)

(* --------------------------------------------------------------
   1. 保護連鎖判斷（最高優先，任一異常立即停機並發出警報）
   -------------------------------------------------------------- *)
IF (X22 = 0)                       (* 緊急停止按鈕動作(常閉接點斷路) *)
   OR (X0  = 1)                    (* 冰水主機故障 *)
   OR (X25 = 0)                    (* 總電源/相序異常 *)
   OR (X20 = 0)                    (* 水塔水盤液位異常 *)
   OR ((M10 = TRUE) AND (X17 = 0)) (* 冷卻水側已啟動後，流量開關斷訊 *)
   OR ((M11 = TRUE) AND (X16 = 0)) (* 冰水側已啟動後，流量開關斷訊 *)
THEN
    M20 := TRUE;
ELSE
    M20 := FALSE;
END_IF;

IF X22 = 0 THEN
    M21 := TRUE;   (* 緊急停止動作旗標，需人員現場復歸後才能清除 *)
END_IF;

(* 保護連鎖動作：立即停止全部設備、發出警報，中止本次掃描其餘程序 *)
IF M20 = TRUE THEN
    Y0  := FALSE;
    Y1  := FALSE;
    Y2  := FALSE;
    Y3  := FALSE;
    Y4  := FALSE;
    Y5  := FALSE;
    Y6  := FALSE;
    Y7  := TRUE;     (* 警報燈 ON *)
    Y10 := TRUE;     (* 蜂鳴器 ON *)
    M0  := FALSE;
    M2  := FALSE;
    M3  := FALSE;
    M10 := FALSE;
    M11 := FALSE;
    M12 := FALSE;
    RETURN;
END_IF;


(* --------------------------------------------------------------
   2. 啟停要求擷取（來源：MCC盤面按鈕，可視需要改接SCADA/排程旗標）
   -------------------------------------------------------------- *)
IF (X23 = 1) AND (M2 = FALSE) THEN
    M0 := TRUE;
    M1 := FALSE;
END_IF;

IF X24 = 1 THEN
    M1 := TRUE;
    M0 := FALSE;
END_IF;


(* --------------------------------------------------------------
   3. 開機程序
   -------------------------------------------------------------- *)

(* Step1：啟動冷卻水塔風扇＋冷卻水泵浦，建立冷卻水循環 *)
IF (M0 = TRUE) AND (M10 = FALSE) AND (M1 = FALSE) THEN
    Y1  := TRUE;
    Y2  := TRUE;
    Y5  := TRUE;
    Y6  := TRUE;
    M10 := TRUE;
END_IF;

(* 確認冷卻水流量開關ON，計時延時 *)
T0(IN := (M10 = TRUE) AND (X17 = 1), PT := T#20S);

(* Step2：延時後啟動冰水泵浦，建立冰水循環 *)
IF (T0.Q = TRUE) AND (M11 = FALSE) AND (M1 = FALSE) THEN
    Y3  := TRUE;
    Y4  := TRUE;
    M11 := TRUE;
END_IF;

(* 確認冰水流量開關ON，計時延時 *)
T1(IN := (M11 = TRUE) AND (X16 = 1), PT := T#15S);

(* Step3：延時後下達冰水主機遠端啟動指令 *)
IF (T1.Q = TRUE) AND (M12 = FALSE) AND (M1 = FALSE) THEN
    Y0  := TRUE;
    M12 := TRUE;
    M2  := TRUE;   (* 系統進入運轉中狀態 *)
END_IF;


(* --------------------------------------------------------------
   4. 停機程序
   -------------------------------------------------------------- *)

(* 接獲停機要求：先停冰水主機 *)
IF (M1 = TRUE) AND (M2 = TRUE) AND (M3 = FALSE) THEN
    Y0  := FALSE;
    M3  := TRUE;
END_IF;

(* 延遲待機組餘熱排除 *)
T2(IN := (M3 = TRUE), PT := T#180S);

(* 延時到，依序停止冰水泵浦、冷卻水泵浦、冷卻水塔風扇，並重置狀態旗標 *)
IF T2.Q = TRUE THEN
    Y3  := FALSE;
    Y4  := FALSE;
    Y5  := FALSE;
    Y6  := FALSE;
    Y1  := FALSE;
    Y2  := FALSE;

    M0  := FALSE;
    M1  := FALSE;
    M2  := FALSE;
    M3  := FALSE;
    M10 := FALSE;
    M11 := FALSE;
    M12 := FALSE;
END_IF;


(* --------------------------------------------------------------
   5. 警報輸出邏輯
   -------------------------------------------------------------- *)
IF M20 = FALSE THEN
    Y7  := FALSE;   (* 無異常時警報燈熄滅(蜂鳴器建議另設消音按鈕邏輯，此處先隨警報燈同步) *)
    Y10 := FALSE;
END_IF;


(* --------------------------------------------------------------
   6. VFD通訊/類比監視（預留介面，需依實際通訊模組完成）
   -------------------------------------------------------------- *)
(*
   本程式不含類比輸出(AO)頻率指令，泵浦/風扇VFD頻率指令改由
   RS-485 Modbus RTU 通訊下達，建議另建子程式(如 R_ModbusComm)，
   於其中呼叫FX5U內建RS-485「預先定義通訊協定」或Modbus主站功能，
   依下列邏輯運算後寫入各VFD頻率設定暫存器：
     - 冷卻水塔風扇頻率：依冷卻水回水溫度(讀自冰水主機通訊資料)PID運算
     - 冰水泵浦頻率　　：依冰水側供回水壓差(定壓差控制)PID運算
     - 冷卻水泵浦頻率　：依冷凝器負荷/壓差PID運算
   D1000~D1003類比壓力訊號僅作監視與趨勢記錄，上傳SCADA顯示。
*)

(* ===================== 程式結束 ===================== *)
