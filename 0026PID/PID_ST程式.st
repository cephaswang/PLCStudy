(* ============================================================
   三菱 iQ-R (RCPU R16EN) PID 命令 — Structured Text (ST) 版本
   由原本的梯形圖 (Ladder) 程式轉譯而來，邏輯與參數意義完全對應
   ============================================================ *)

(* ------------------------------------------------------------
   宣告區
   R_TRIG_SM411：用來偵測 SM411（0.2秒時脈）的上升緣。
   梯形圖裡的 "ANDP SM411" 本身就是「取上升緣再做AND」，
   但 ST 語言沒有內建的邊緣觸發運算子，所以要另外宣告一個
   R_TRIG（上升緣偵測）功能塊來做一樣的事情，否則若直接寫
   "IF M1 AND SM411 THEN"，只要 SM411=ON 就會「每個掃描」
   都執行一次，而不是「每0.2秒觸發一次」，行為會不一樣。
   ------------------------------------------------------------ *)
VAR
    R_TRIG_SM411 : R_TRIG;   (* SM411 上升緣偵測用實例 *)
END_VAR


(* ============================================================
   1. 開機／每次掃描：寫入 PID 參數
   SM400 是恆為 ON 的特殊繼電器，所以這個 IF 其實等於
   「每一個掃描都執行」，跟原梯形圖「LD SM400」的效果一致。
   若只想在開機時寫入一次，可改用 SM402（僅第一次掃描ON）。
   ============================================================ *)
IF SM400 THEN
    D100 := 100;     (* (s3)+0  TS  採樣時間 = 100 ms                         *)
    D101 := 33;      (* (s3)+1  ACT 二進位100001 → b0=1逆動作, b5=1啟用輸出上下限 *)
    D102 := 0;       (* (s3)+2  α   輸入濾波常數 = 0（不濾波）                 *)
    D103 := 200;     (* (s3)+3  KP  比例增益 = 200 %                          *)
    D104 := 10;      (* (s3)+4  TI  積分時間 = 10 × 100ms = 1 秒               *)
    D105 := 5;       (* (s3)+5  KD  微分增益 = 5 %                            *)
    D106 := 100;     (* (s3)+6  TD  微分時間 = 100 × 10ms = 1 秒               *)
    D122 := 10000;   (* (s3)+22 因 ACT b5=1、b2=0 → 此處代表「輸出上限」= 10000 *)
    D123 := 0;       (* (s3)+23 同上，此處代表「輸出下限」= 0                  *)
END_IF;


(* ============================================================
   2. 模擬量測值 (PV) 變化
   目的：在沒有實際感測器接線的情況下，讓 D2（PID的PV）能自己
   動起來，方便測試 PID 參數效果。
   條件：M1 = ON，且 SM411 每 0.2 秒出現一次上升緣：
     - 若 M0 = OFF → D2 加 1
     - 若 M2 = ON  → D2 減 1
   （兩個條件各自獨立判斷，若同時成立，加1減1會互相抵銷，
   這跟原梯形圖 MPS/MPP 分兩支執行的效果相同）
   ============================================================ *)
R_TRIG_SM411(CLK := SM411);

IF M1 AND R_TRIG_SM411.Q THEN
    IF NOT M0 THEN
        D2 := D2 + 1;   (* 對應梯形圖: ANI M0 → INC D2 *)
    END_IF;

    IF M2 THEN
        D2 := D2 - 1;   (* 對應梯形圖: AND M2 → DEC D2 *)
    END_IF;
END_IF;


(* ============================================================
   3. 執行 PID 運算
   當 M0 = ON 時執行：
     S1 = D0   目標值 SV
     S2 = D2   量測值 PV（就是上面被模擬增減的那個值）
     S3 = D100 參數區起始位址（對應第10.5節參數表）
     D  = D10  運算後輸出的操作量 MV
   ============================================================ *)
IF M0 THEN
    PID(D0, D2, D100, D10);
END_IF;

(* ------------------------------------------------------------
   提醒：這裡的 D10（PID輸出 MV）目前沒有接到任何實際輸出。
   實機使用時，請在這裡之後加上把 D10 寫到類比輸出模組
   或其他執行機構（例如 TO 指令、FROM/TO、或功能區塊呼叫）的程式。
   ------------------------------------------------------------ *)
