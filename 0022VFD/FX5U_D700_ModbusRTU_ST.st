(* ============================================================================
   程式名稱　: FX5U ↔ FR-D700 (Modbus-RTU) 通訊主程式
   語　　言　: 結構化文字 ST (Structured Text) - 適用 GX Works3 / FX5U CPU
   通訊方式　: 內建 RS-485 埠 CH1，Modbus-RTU 主站，使用 ADPRW 指令
   對應設備　: FR-D700 變頻器 (Pr.549=1 設為 Modbus-RTU 協定，站號 Pr.117=1)

   功能說明　: 每 100ms 輪詢一次，依序執行三個步驟並循環：
              步驟1：寫入頻率設定值 (Modbus 位址 0x0D / 40014)
              步驟2：寫入控制字，正轉/反轉/停止 (Modbus 位址 0x08 / 40009)
              步驟3：讀取輸出頻率/電流/電壓監視值 (Modbus 位址 0xC8 / 40201起3字)

   本版本已修正原梯形圖(ProgPou.csv)中的下列問題：
     1) 三筆 ADPRW 完成狀態旗標(d2)位址原本互相重疊(M100~106重疊使用)，
        本版改為互不重疊的獨立區塊：M100~102 / M110~112 / M120~122
     2) 解除忙碌旗標 M5 的判斷條件原本用「執行中 OR 正常完成」，會在指令
        剛觸發、通訊尚未真正結束時就提早解除；本版改為「正常完成 OR 異常
        完成」，確認該筆 Modbus 通訊確實結束(不論成功或失敗)才放行下一步
     3) 全部步驟均補上完整中文註解
   ============================================================================ *)

VAR
    Clk100ms_R  : R_TRIG;   // 100ms 時脈(SM8012)上升緣偵測用
    StepTrig_R  : R_TRIG;   // 步驟觸發訊號(M0/M1/M2)上升緣偵測用
END_VAR

(* ------------------------------------------------------------------
   0. 開機初始化
   SM8002：初始化條件(請於 GX Works3 中確認其確切定義，
           一般用途為開機/RUN後產生的初始脈衝)
   ------------------------------------------------------------------ *)
IF SM8002 THEN
    D20 := 0;   // 頻率設定緩衝區清零
                // ※本值需由 HMI、類比輸入換算或其他邏輯持續寫入實際頻率，
                //   若始終為 0，變頻器將持續被下達 0Hz 運轉指令
    D30 := 0;   // 控制字緩衝區清零 (0=停止 / 2=正轉 / 4=反轉)
END_IF;

(* ------------------------------------------------------------------
   1. 100ms 輪詢步驟計數器 D10：1→2→3→4→歸零，循環輪詢
      忙碌旗標 M5 為 ON 時(通訊尚未結束)，計數器暫停，不前進下一步
   ------------------------------------------------------------------ *)
Clk100ms_R(CLK := SM8012);
IF Clk100ms_R.Q AND NOT M5 THEN
    D10 := D10 + 1;
END_IF;

M0 := (D10 = 1);   // 步驟1觸發：寫頻率
M1 := (D10 = 2);   // 步驟2觸發：寫控制字
M2 := (D10 = 3);   // 步驟3觸發：讀監視值

IF D10 = 4 THEN
    D10 := 0;      // 三步驟跑完，計數器歸零，重新開始下一輪
END_IF;

(* ------------------------------------------------------------------
   2. 任一步驟觸發(M0/M1/M2 由 0→1)時，鎖定忙碌旗標 M5，
      避免計數器在通訊完成前繼續前進、重複觸發 ADPRW
   ------------------------------------------------------------------ *)
StepTrig_R(CLK := (M0 OR M1 OR M2));
IF StepTrig_R.Q THEN
    M5 := TRUE;
END_IF;

(* ==============================================================
   步驟1：寫入頻率設定值
   ADPRW 參數: (EN, 站號, 功能碼, Modbus位址, 功能參數, 資料來源, 完成狀態)
     站號     = 1                (對應 D700 之 Pr.117)
     功能碼   = 16#06            (寫單一保持暫存器)
     位址     = 16#0D  (=13)     對應 Modbus 40014 頻率設定暫存器
     資料來源 = D20              寫入之頻率值
     完成狀態 = M100(執行中) / M101(正常完成) / M102(異常完成)
   ============================================================== *)
ADPRW(M0, 1, 16#06, 16#0D, 0, D20, M100);

IF M101 OR M102 THEN   // 通訊已結束(成功或失敗皆算) → 解除忙碌旗標
    M5 := FALSE;
END_IF;

(* ------------------------------------------------------------------
   依外部指令位元(M10正轉/M11反轉/M12停止)計算控制字 D30
   三者互斥判斷，寫入結果供步驟2使用
   ------------------------------------------------------------------ *)
IF M10 AND NOT M11 AND NOT M12 THEN
    D30 := 2;   // 正轉指令
ELSIF M11 AND NOT M10 AND NOT M12 THEN
    D30 := 4;   // 反轉指令
ELSIF M12 AND NOT M10 AND NOT M11 THEN
    D30 := 0;   // 停止指令
END_IF;

(* ==============================================================
   步驟2：寫入控制字 (啟動/停止/正反轉)
     位址     = 16#08  (=8)      對應 Modbus 40009 控制字暫存器
     資料來源 = D30
     完成狀態 = M110(執行中) / M111(正常完成) / M112(異常完成)
   ============================================================== *)
ADPRW(M1, 1, 16#06, 16#08, 0, D30, M110);

IF M111 OR M112 THEN
    M5 := FALSE;
END_IF;

(* ==============================================================
   步驟3：讀取監視值 (輸出頻率／電流／電壓，共3個保持暫存器)
     功能碼   = 16#03            (讀取保持暫存器)
     位址     = 16#C8  (=200)    對應 Modbus 40201 起
     點數     = 3                連續讀取3個字
     儲存位置 = D100(輸出頻率) / D101(輸出電流) / D102(輸出電壓)
     完成狀態 = M120(執行中) / M121(正常完成) / M122(異常完成)
   ============================================================== *)
ADPRW(M2, 1, 16#03, 16#C8, 3, D100, M120);

IF M121 OR M122 THEN
    M5 := FALSE;
END_IF;

(* ------------------------------------------------------------------
   停止狀態判斷：輸出頻率/電流/電壓皆為 0 時，視為變頻器已停止
   ------------------------------------------------------------------ *)
M200 := (D100 = 0) AND (D101 = 0) AND (D102 = 0);
